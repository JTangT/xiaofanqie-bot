# Copy to .env and fill in your own values:
#     cp .env.example .env
#
# .env is gitignored and excluded from the Docker build context, so the token
# is never committed and never baked into an image layer.

# Required. Get one from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-your-real-token-here

# Optional. Route Telegram traffic through a proxy. Useful when the direct
# link to api.telegram.org is slow or unstable (see README, "网络超时").
# HTTP/HTTPS proxies work as-is; SOCKS5 additionally needs `httpx[socks]`.
# TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
